# Copy these values into your deployment secret manager or local environment. Do not commit .env.
POSTGRES_PASSWORD=replace-me
GOOGLE_CLIENT_SECRET=replace-me
JWT_PRIVATE_KEY=file:/absolute/path/to/codepal-jwt-private.pem
JWT_PUBLIC_KEY=file:/absolute/path/to/codepal-jwt-public.pem
NVIDIA_API_KEY=replace-me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=replace-me
GROQ_BASE_URL=https://api.groq.com/openai/v1
COOKIE_SECURE=true

# Generated MERN project services (infra/docker-compose.local.yml)
MONGO_ROOT_USERNAME=codepal
MONGO_ROOT_PASSWORD=replace-me-local
MONGO_URI=mongodb://codepal:replace-me-local@localhost:27017/codepal?authSource=admin
MONGO_DATABASE=codepal
MINIO_ROOT_USER=codepal
MINIO_ROOT_PASSWORD=replace-me-local
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=codepal-artifacts

# Agent runtime controls
AGENT_LLM_MAX_ATTEMPTS=3
AGENT_LLM_RETRY_INITIAL_BACKOFF_MS=500
AGENT_LLM_RETRY_MAX_BACKOFF_MS=5000
AGENT_WORKER_CONCURRENCY=2
AGENT_TOOL_CONCURRENCY=4
AGENT_STREAM_BATCH_CHARS=96
AGENT_STREAM_BATCH_INTERVAL_MS=250
AGENT_STALE_SWEEP_INTERVAL_MS=30000
AGENT_ROLLBACK_ON_FAILURE=true
AGENT_SANDBOX_REQUIRED=true
AGENT_SANDBOX_DOCKER_COMMAND=wsl.exe
# Windows backend with Docker installed only in WSL: wsl.exe and -e docker
AGENT_SANDBOX_DOCKER_COMMAND_ARGS=-e docker
AGENT_SANDBOX_IMAGE=node:22-bookworm-slim
AGENT_SANDBOX_IDLE_STOP_MS=900000
AGENT_SANDBOX_IDLE_REMOVE_MS=86400000
AGENT_SANDBOX_CLEANUP_INTERVAL_MS=60000
AGENT_SANDBOX_MAX_PROJECT_BYTES=500000000

# Separate origin for previews and published sites (must differ from the API by host)
APP_SITES_BASE_URL=http://127.0.0.1:8080

# Project files: keep them in WSL ext4 so sandbox containers can bind-mount them at native speed.
# The backend (Windows) reads them through the WSL share; the Docker-side path is derived from this.
AGENT_WORKSPACE_PATH=//wsl.localhost/Ubuntu-24.04/home/<user>/codepal/workspaces
# Only if Docker sees the folder under a different path:
# AGENT_SANDBOX_HOST_WORKSPACE_PATH=/home/<user>/codepal/workspaces

# Dependency installs: a short-lived container that alone may reach package registries; lifecycle
# scripts are disabled. Installed sets are cached per project in .codepal/deps.
AGENT_SANDBOX_INSTALL_NETWORK=bridge
AGENT_SANDBOX_INSTALL_TIMEOUT_MS=300000
AGENT_SANDBOX_MAX_DEPENDENCY_BYTES=1000000000

# Runtime check: before committing, the staged site is loaded in headless Chromium (image built
# once from src/main/resources/sandbox/browser, ~1.3 GB; no network, read-only site).
AGENT_SANDBOX_RUNTIME_CHECK=true
AGENT_SANDBOX_BROWSER_IMAGE=codepal-browser
AGENT_SANDBOX_BROWSER_TIMEOUT_MS=60000
